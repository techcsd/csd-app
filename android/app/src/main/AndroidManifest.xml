<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/AppTheme">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AQ1 — FCM usa este canal de ALTA importancia por defecto para las push
             de notificación (heads-up + sonido). El canal se crea en MainActivity. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="avisos_csd" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!-- AL6 — alarma dominical autónoma. El receiver corre con la app cerrada. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false" />
        <!-- AL6 — re-programar la alarma tras un reinicio del teléfono. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- V3: install a downloaded APK from within the app (rolling update). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- M1: la cámara EMBEBIDA (getUserMedia) del pre-uso necesita que la app
         tenga el permiso CAMERA del SO; sin él el WebView deniega getUserMedia,
         el overlay cae al fallback de cámara del sistema y MIUI mata el proceso.
         La cámara del teléfono no está disponible sin cámara física. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- P1: nota de voz del incidente (getUserMedia({audio:true}) en el WebView).
         Sin RECORD_AUDIO el WebChromeClient de Capacitor deniega el micrófono. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- P2: GPS de crear-ruta / recibir vehículo (@capacitor/geolocation). El
         manifest del plugin en node_modules va vacío y no aporta estos permisos
         en el merge, así que hay que declararlos aquí. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- AF27 — tracking en segundo plano durante rutas activas (foreground service,
         @capacitor-community/background-geolocation). El servicio y sus permisos
         FOREGROUND_SERVICE(_LOCATION) los aporta el manifest del plugin en el merge;
         ACCESS_BACKGROUND_LOCATION (Android 10+) se declara aquí. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- AK13 — permitir pedir la exclusión de optimización de batería (MIUI/OEM
         agresivos matan el foreground service y se pierde el trayecto). El prompt
         nativo se añadirá con un plugin; la app ya guía la config manual mientras. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- AL6 — alarma dominical AUTÓNOMA de inspección (suena con la app cerrada). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- AL5 — notificaciones (Android 13+). El permiso runtime lo pide el onboarding. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- W2: "Cómo llegar" abre Google Maps con @capacitor/app-launcher. En
         Android 11+ (package visibility) `canOpenUrl` devuelve false a menos que
         declaremos los esquemas/intents que vamos a consultar. Sin esto el
         intent de navegación nunca se detecta y siempre cae al fallback https. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="google.navigation" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>
</manifest>
