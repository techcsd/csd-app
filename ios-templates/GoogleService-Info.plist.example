<?xml version="1.0" encoding="UTF-8"?>
<!-- CI9 — PLANTILLA. El archivo real (GoogleService-Info.plist) va FUERA de git y lo
     inyecta el workflow desde el secreto GOOGLE_SERVICE_INFO_PLIST (base64). Se obtiene
     al crear la app iOS (com.constructorasd.csdapp) en Firebase (proyecto csd-core).
     Igual que google-services.json en Android. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>API_KEY</key><string>[DESDE FIREBASE]</string>
  <key>GCM_SENDER_ID</key><string>[DESDE FIREBASE]</string>
  <key>BUNDLE_ID</key><string>com.constructorasd.csdapp</string>
  <key>PROJECT_ID</key><string>csd-core</string>
  <key>GOOGLE_APP_ID</key><string>[DESDE FIREBASE]</string>
  <key>IS_GCM_ENABLED</key><true/>
</dict>
</plist>
